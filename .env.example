# ---- Core ----
# Public base URL of the server. In dev, your ngrok/cloudflared HTTPS URL
# (platform OAuth callbacks and webhooks must reach it over HTTPS).
APP_URL=https://your-public-url.example.com
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Used by server and worker when NOT running via docker-compose
# (compose injects its own DATABASE_URL pointing at the db service).
DATABASE_URL=postgres://stocksense:stocksense@localhost:5432/stocksense

# ---- BigCommerce app (devtools.bigcommerce.com -> create app) ----
# Auth callback URL:  {APP_URL}/auth/bigcommerce/callback
# Load callback URL:  {APP_URL}/auth/bigcommerce/load
# Scopes: Orders (read-only), Products (read-only), Information (read-only)
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# ---- Shopify app (partners.shopify.com -> create app) ----
# App URL:            {APP_URL}/
# Redirect URL:       {APP_URL}/auth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ---- Alerts (Resend free tier: resend.com) ----
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=you@yourdomain.com
ALERT_DIGEST_HOUR=8

# ---- Sync ----
BACKFILL_MONTHS=18

# ---- Ask StockSense (AI answers in the app and on WhatsApp) ----
# Google Gemini: key from https://aistudio.google.com/apikey (starts with AIza)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Or Claude: key from console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
# ASK_MODEL=claude-opus-5-5
# With both keys set, AI_PROVIDER=gemini or AI_PROVIDER=anthropic picks one.

# ---- WhatsApp assistant (Meta WhatsApp Cloud API) ----
# Meta webhook URL: {APP_URL}/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Approved template (one body variable) for alerts outside the 24-hour window
WHATSAPP_ALERT_TEMPLATE=

# ---- SMS alerts (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
